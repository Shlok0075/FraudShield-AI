# FraudShield AI - Environment Variables (EXAMPLE -- copy to .env, never commit real .env)
ENVIRONMENT=development

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fraudshield

# JWT secret -- generate your own, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins (never use "*")
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limits (slowapi syntax)
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_PREDICT=60/minute

# Path to the ml/models directory produced by ml/src/train.py
ML_MODELS_DIR=../ml/models
